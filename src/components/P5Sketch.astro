---
interface Props {
  src: string;
  height?: number;
  caption?: string;
}

const { src, height = 400, caption } = Astro.props;
---

<figure class="p5-figure">
  <div class="p5-container" data-sketch-src={src} style={`height: ${height}px`}></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { mountSketch } from '../scripts/p5';
  async function loadSketches() {
    for (const container of document.querySelectorAll<HTMLElement>('[data-sketch-src]')) {
      try {
        const module = await import(/* @vite-ignore */ container.dataset.sketchSrc!);
        await mountSketch(container, module.default);
      } catch (error) {
        console.warn('Sketch unavailable:', error);
      }
    }
  }
  document.addEventListener('astro:page-load', loadSketches);
</script>

<style>
  .p5-figure {
    margin: 1.5em 0;
  }
  .p5-container {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    border: 0.5px solid var(--border);
    background: var(--bg-subtle);
  }
  figcaption {
    font-size: 0.8em;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.5em;
  }
</style>
