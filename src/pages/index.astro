---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import SignalStudy from '../components/SignalStudy.astro';
import { projects } from '../data/projects';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const selected = ['sketchlet','baker-parks'].map(slug => projects.find(p=>p.slug===slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest = posts[0];
const summaries: Record<string,string> = {
  sketchlet: 'A daily drawing playground. Exploring how a small creative ritual can bring people together.',
  'baker-parks': 'A different way into San Francisco’s parks. Public information, accessibility, and a reason to get outside.'
};
---
<!doctype html>
<html lang="en">
<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /><ClientRouter /></head>
<body><Header /><main id="main-content" class="home">
  <div class="edition"><span>THE WORK & THE WORK IN PROGRESS</span><span>MICHAEL BAKER / INDEPENDENT PROJECTS</span></div>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy"><p class="eyebrow"><span class="dot"></span> Content. Systems. Creative tools.</p>
      <h1 id="intro-title">A curious mind.<br />A working<br /><span>prototype.</span></h1>
      <p class="intro-deck">Twenty years working with content.<br />An expanding collection of things I build.</p>
      <p class="intro-note">I explore how information, interfaces, and a little imagination can make everyday experiences better. These are my projects and the notes along the way.</p>
      <div class="intro-links"><a class="primary-link" href="#selected-work">Explore the work <span aria-hidden="true">↘</span></a><a href="/about">A little about me ↗</a></div>
    </div><SignalStudy />
  </section>
  {latest && <a class="dispatch" href={`/blog/${latest.id}/`}><span class="eyebrow">LATEST FIELD NOTE <span class="dispatch-date"><FormattedDate date={latest.data.pubDate} /></span></span><span class="dispatch-title">{latest.data.title}</span><span class="dispatch-arrow" aria-hidden="true">↗</span></a>}
  <section id="selected-work" class="work"><div class="section-heading"><h2>Selected work<span class="index"> / 01—02</span></h2><a href="/projects">All projects ↗</a></div>
    <div class="selected-grid">{selected.map((project,i)=><article class="selected-card"><a class="media-link" href={`/projects/${project.slug}`} aria-label={`Explore ${project.name}`}><ProjectMedia {...project} /></a><div class="project-caption"><span class="eyebrow">0{i+1} / {project.slug==='sketchlet'?'CREATIVE PLAY':'PUBLIC INFORMATION'}</span><span class="eyebrow">IN DEVELOPMENT</span></div><h3><a href={`/projects/${project.slug}`}>{project.name}<span aria-hidden="true">↗</span></a></h3><p>{summaries[project.slug] || project.description}</p></article>)}</div>
  </section>
  <section class="journal"><div class="section-heading"><h2>Notes from the process</h2><a href="/blog">All writing ↗</a></div><div class="journal-layout"><p class="journal-intro">What sparked an idea.<br />What took a few tries.<br /><em>What comes next.</em></p><ol class="journal-list">{posts.filter(post => post.id !== latest?.id).slice(0,2).map(post=><li><div class="eyebrow"><FormattedDate date={post.data.pubDate} /> / {post.data.tags?.[0] || 'BUILD NOTES'}</div><h3><a href={`/blog/${post.id}/`}>{post.data.title} <span aria-hidden="true">↗</span></a></h3><p>{post.data.description}</p></li>)}</ol></div></section>
  <aside class="about-strip"><p class="eyebrow">A THREAD THROUGH THE WORK</p><h2>Making complex<br />things more usable.</h2><div><p>From online art and design education to enterprise technology, I’ve worked with the content that helps people learn and get things done. Now I’m building more of the tools around it.</p><a href="/about">The longer story ↗</a></div></aside>
</main><Footer /></body></html>
<style>
.home { padding-top:0; }.edition { display:flex; justify-content:space-between; gap:15px; border-bottom:1px solid var(--border); padding:18px 0; font:9px/1.5 var(--font-mono); letter-spacing:.08em; color:var(--text-muted); }
.intro { display:grid; grid-template-columns:1.15fr 1fr; align-items:center; gap:64px; padding:64px 0; }
.dot { display:inline-block; width:6px; height:6px; background:var(--orange); margin-right:6px; border-radius:50%; }
h1 { font-size:clamp(3rem,5.8vw,5rem); letter-spacing:-.065em; line-height:1.02; margin:24px 0; }h1 span { color:var(--accent); }
.intro-deck { font-size:1.2rem; line-height:1.5; margin-bottom:18px; }.intro-note { font-size:15px; max-width:420px; color:var(--text-muted); }
.intro-links { display:flex; flex-wrap:wrap; gap:24px; align-items:center; margin-top:30px; font:12px var(--font-mono); }.primary-link { padding:13px 17px; color:var(--bg); background:var(--text); border:1px solid var(--text); }.primary-link:hover { color:var(--bg); }.primary-link span { margin-left:24px; }
.dispatch { border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:25px 0; display:grid; grid-template-columns:230px 1fr 32px; align-items:center; gap:30px; color:var(--text); }.dispatch-date { display:block; margin-top:7px; }.dispatch-title { font-size:1.45rem; font-weight:700; letter-spacing:-.025em; }.dispatch-arrow { font-size:28px; color:var(--orange); }
.work,.journal { margin-top:80px; scroll-margin-top:30px; }.index { font:11px var(--font-mono); color:var(--text-muted); margin-left:15px; }
.selected-grid { display:grid; grid-template-columns:1fr 1fr; gap:36px; }.media-link { display:block; overflow:hidden; border:1px solid var(--border); }.media-link :global(> *) { transition:transform .4s; }.media-link:hover :global(> *) { transform:scale(1.025); }
.project-caption { display:flex; justify-content:space-between; gap:12px; margin:20px 0 14px; }.project-caption .eyebrow { font-size:9px; }.selected-card h3 { font-size:2rem; }.selected-card h3 a { color:var(--text); display:flex; justify-content:space-between; }.selected-card h3 span { font-weight:400; color:var(--orange); }.selected-card p { color:var(--text-muted); font-size:16px; max-width:90%; }
.journal-layout { display:grid; grid-template-columns:1fr 2fr; gap:60px; }.journal-intro { font-size:1.3rem; line-height:1.6; }.journal-intro em { color:var(--orange); font-style:normal; }.journal-list { list-style:none; margin:0; padding:0; }.journal-list li { padding:0 0 24px; margin-bottom:24px; border-bottom:1px solid var(--border); }.journal-list h3 { font-size:1.45rem; margin:12px 0; }.journal-list h3 a { color:var(--text); }.journal-list h3 span { color:var(--orange); }.journal-list p { font-size:15px; color:var(--text-muted); margin:0; }
.about-strip { display:grid; grid-template-columns:1fr 1fr; gap:12px 64px; margin-top:55px; padding:38px; background:var(--bg-surface); border-top:3px solid var(--orange); }.about-strip .eyebrow { grid-column:1/-1; }.about-strip h2 { font-size:2.4rem; }.about-strip div { font-size:16px; }.about-strip a { font:12px var(--font-mono); }
@media(max-width:850px) { .intro { gap:30px; } .project-caption { flex-direction:column; gap:4px; } }
@media(max-width:640px) { .edition span:last-child { display:none; }.intro { grid-template-columns:1fr; padding:35px 0; gap:34px; }h1 { font-size:3.5rem; }.intro :global(.signal) { max-height:360px; }.dispatch { grid-template-columns:1fr 24px; gap:12px; }.dispatch .eyebrow { grid-column:1/-1; }.dispatch-date { display:inline; margin-left:10px; }.selected-grid,.journal-layout,.about-strip { grid-template-columns:1fr; gap:24px; }.work,.journal { margin-top:50px; }.journal-intro { font-size:1.15rem; }.about-strip { padding:24px; }.index { display:none; } }
</style>
