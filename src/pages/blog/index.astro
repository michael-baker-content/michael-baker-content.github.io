---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<!doctype html><html lang="en"><head><BaseHead title="Writing — Michael Baker" description="Field notes on building tools, exploring ideas, and learning through the work." /><ClientRouter /></head><body><Header />
<main id="main-content"><p class="eyebrow">THE JOURNAL / {String(posts.length).padStart(2,'0')} ENTRIES</p><div class="archive-head"><div><h1>Notes from<br />the process.</h1><p>Ideas, decisions, detours. A record of the work as it happens.</p></div><div class="search-wrap"><label for="search" class="eyebrow">FIND SOMETHING INTERESTING</label><input type="search" id="search" placeholder="Search writing…" aria-label="Search posts" autocomplete="off" /></div></div>
<p id="no-results" role="status" hidden>No posts match your search.</p><ul id="post-list">{posts.map((post,i)=><li class="post-card" data-title={post.data.title.toLowerCase()} data-desc={post.data.description.toLowerCase()} data-tags={(post.data.tags??[]).join(' ').toLowerCase()}><div class="post-meta"><span class="eyebrow">{String(posts.length-i).padStart(2,'0')} / FIELD NOTE</span><FormattedDate date={post.data.pubDate} /></div><div><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="tags">{post.data.tags?.slice(0,4).map(tag=><a href={`/tags/${tag}`}>{tag}</a>)}</div></div><a class="entry-arrow" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>↗</a></li>)}</ul>
</main><Footer /></body></html>
<script>
function initSearch() {
 const input=document.querySelector<HTMLInputElement>('#search');
 const list=document.querySelector('#post-list');
 const empty=document.querySelector<HTMLElement>('#no-results');
 if(!input||!list||!empty)return;
 const filter=()=>{let count=0;const query=input.value.toLowerCase().trim();list.querySelectorAll<HTMLElement>('.post-card').forEach(card=>{const match=!query||[card.dataset.title,card.dataset.desc,card.dataset.tags].some(value=>value?.includes(query));card.hidden=!match;if(match)count++;});empty.hidden=count>0;};
 input.addEventListener('input',filter);filter();
}
document.addEventListener('astro:page-load',initSearch);
</script>
<style>
.archive-head { display:grid; grid-template-columns:1.5fr 1fr; gap:50px; align-items:end; margin:25px 0 55px; }.archive-head p { color:var(--text-muted); font-size:17px; margin:0; }.search-wrap { display:flex; flex-direction:column; gap:12px; padding-bottom:5px; }input { width:100%; background:transparent; border:0; border-bottom:1px solid var(--text-muted); padding:14px 0; border-radius:0; color:var(--text); font-size:16px; }
ul { list-style:none; margin:0; padding:0; }.post-card { display:grid; grid-template-columns:190px 1fr 40px; gap:40px; padding:35px 0; border-top:1px solid var(--border); }.post-card[hidden] { display:none; }.post-meta { display:flex; flex-direction:column; gap:12px; color:var(--text-muted); padding-top:5px; }h2 { font-size:clamp(1.5rem,2.7vw,2.1rem); }h2 a { color:var(--text); }.post-card p { font-size:16px; color:var(--text-muted); max-width:680px; }.tags { display:flex; flex-wrap:wrap; gap:15px; }.tags a { color:var(--text-muted); }.entry-arrow { font-size:28px; color:var(--orange); }
@media(max-width:720px) { .archive-head { grid-template-columns:1fr; gap:25px; }.post-card { grid-template-columns:1fr 25px; gap:15px; }.post-meta { grid-column:1/-1; flex-direction:row; justify-content:space-between; }.entry-arrow { font-size:22px; } }
</style>
